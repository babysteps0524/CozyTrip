---
const { guide } = Astro.props;
---
<a href={`/guides/${guide.slug}/`} group flex gap="4" rounded="2xl" border="line" bg="white" p="3" transition hover="border-brand-200 shadow-card" dark="border-slate-800 bg-slate-900" >
  <img src={guide.image} alt="" loading="lazy" width="180" height="150" h="28" w="28" shrink-0 rounded="xl" object="cover" sm="h-32 w-40" />
  <div flex="col" min="w-0" justify="center" py="1"><span text="xs brand-600" font="bold">{guide.category} · {guide.readTime}</span><h3 mt="2" font="bold" leading="snug" group-hover="text-brand-700" dark="text-white" text="base sm:lg ink" >{guide.title}</h3><p mt="2" leading="6" line-clamp-2 dark="text-slate-300" text="sm muted" >{guide.excerpt}</p><span mt="2" font="semibold" text="xs brand-600" >가이드 읽기 →</span></div>
</a>
