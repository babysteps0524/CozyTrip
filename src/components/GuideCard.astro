---
const { guide } = Astro.props;
---

<a
  href={`/guides/${guide.slug}/`}
  group
  flex
  gap="4"
  rounded="2xl"
  border="line hover:brand-200 dark:neutral-800"
  shadow="hover:card"
  bg="white dark:neutral-900"
  p="3"
  transition
>
  <img
    src={guide.image}
    alt={`${guide.title} 가이드 썸네일`}
    loading="lazy"
    width="180"
    height="150"
    h="28"
    w="28"
    shrink-0
    rounded="xl"
    object="cover"
    sm="h-32 w-40"
  />
  <div flex="col" min="w-0" justify="center" py="1">
    <span text="xs brand-600" font="bold">
      {guide.category} · {guide.readTime}
    </span>
    <h3
      mt="2"
      font="bold"
      leading="snug"
      group-hover="text-brand-700"
      text="base sm:lg ink dark:white"
    >
      {guide.title}
    </h3>
    <p mt="2" leading="6" line-clamp-2 text="sm muted dark:neutral-300">
      {guide.excerpt}
    </p>
    <span mt="2" font="semibold" text="xs brand-600">
      가이드 읽기 →
    </span>
  </div>
</a>
