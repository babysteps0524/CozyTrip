---
const { slot = 'article', label = '광고' } = Astro.props;
const client = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const slotId =
  slot === 'home'
    ? import.meta.env.PUBLIC_ADSENSE_SLOT_HOME
    : import.meta.env.PUBLIC_ADSENSE_SLOT_ARTICLE;
const configured = Boolean(client && slotId);
---

{configured ? (
  <div
    my="8"
    overflow="hidden"
    rounded="2xl"
    border="line dark:slate-700"
    bg="white dark:slate-900"
    p="3"
    text="center"
    aria-label={label}
  >
    <span mb="2" block text="[10px] muted" tracking="widest">
      ADVERTISEMENT
    </span>
    <ins
      adsbygoogle
      block
      data-ad-client={client}
      data-ad-slot={slotId}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>
      (window.adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </div>
) : (
  <div
    my="8"
    flex
    min="h-24"
    items="center"
    justify="center"
    rounded="2xl"
    border="dashed slate-300 dark:slate-700"
    bg="slate-50 dark:slate-900"
    px="4"
    py="5"
    text="center"
    aria-label="광고 자리 안내"
  >
    <div>
      <p text="[10px] slate-400" font="bold" tracking="[.18em]">
        ADVERTISEMENT
      </p>
      <p mt="1" text="xs slate-500">
        광고 영역 · AdSense 설정 후 표시됩니다.
      </p>
    </div>
  </div>
)}
