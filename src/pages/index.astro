---
import SiteLayout from '../layouts/SiteLayout.astro';
import HotelCard from '../components/HotelCard.astro';
import GuideCard from '../components/GuideCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { hotels, regions, guides } from '../data/site';
---

<SiteLayout
  title="CozyTrip"
  description="도쿄·오사카·교토부터 온천과 리조트까지, 일본 호텔 선택과 여행 준비를 돕는 실용적인 가이드."
>
  <section relative isolate overflow="hidden" bg="ink">
    <img
      src="https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?auto=format&fit=crop&w=2200&q=90"
      alt="일본 전통 거리의 풍경"
      fetchpriority="high"
      width="2200"
      height="1100"
      absolute
      inset="0"
      -z-20
      h="full"
      w="full"
      object="cover center"
    />
    <div
      absolute
      inset="0"
      -z-10
      bg="gradient-to-r"
      from-slate-950
      via-slate-900
      to-slate-900
    ></div>
    <div
      container-wide
      grid
      min="h-[520px]"
      items="center"
      gap="10"
      py="16"
      lg="grid-cols-[1.15fr_.85fr] py-24"
    >
      <div max="w-2xl" text="white">
        <span
          inline="flex"
          items="center"
          gap="2"
          rounded="full"
          border="white"
          bg="white"
          px="4"
          py="2"
          text="xs"
          font="semibold"
          backdrop-blur
        >
          JAPAN HOTEL & TRAVEL GUIDE{' '}
          <span h="1.5" w="1.5" rounded="full" bg="emerald-300"></span>
        </span>
        <h1
          mt="6"
          text="4xl sm:5xl lg:6xl"
          font="bold"
          leading="tight"
          tracking="tight"
        >
          일본 여행, 좋은 호텔이
          <br hidden sm:block /> 더 특별한 추억을 만듭니다.
        </h1>
        <p mt="5" leading="8" max="w-xl" text="base sm:lg white">
          도쿄, 오사카, 교토부터 숨겨진 여행지까지. 호텔을 선택하는 기준부터
          예약 전 체크리스트까지 차근차근 살펴보세요.
        </p>
        <form
          action="/search/"
          method="get"
          mt="8"
          grid
          gap="3"
          rounded="2xl"
          bg="white"
          p="3"
          text="ink"
          shadow="lift"
          sm="grid-cols-[1fr_1fr_auto] p-3"
        >
          <label
            flex
            items="center"
            gap="3"
            rounded="xl"
            bg="slate-50"
            px="4"
            py="3"
          >
            <span text="brand-600">⌖</span>
            <span min="w-0" flex="1">
              <span block text="[11px] muted" font="bold">
                목적지
              </span>
              <input
                name="q"
                mt="1"
                w="full"
                bg="transparent"
                text="sm"
                outline="none"
                placeholder="도시 또는 호텔명 text-slate-400"
              />
            </span>
          </label>
          <label
            flex
            items="center"
            gap="3"
            rounded="xl"
            bg="slate-50"
            px="4"
            py="3"
          >
            <span text="brand-600">▦</span>
            <span min="w-0" flex="1">
              <span block text="[11px] muted" font="bold">
                여행 스타일
              </span>
              <select
                name="type"
                mt="1"
                w="full"
                bg="transparent"
                text="sm"
                outline="none"
              >
                <option value="">모든 유형</option>
                <option>도시 호텔</option>
                <option>료칸</option>
                <option>리조트</option>
              </select>
            </span>
          </label>
          <button btn-primary min="h-12" type="submit">
            ⌕ 호텔 찾기
          </button>
        </form>
        <p mt="4" text="xs white">
          호텔 정보는 편집 검토용 데이터와 함께 제공됩니다. 예약 전 최신 정보를
          확인하세요.
        </p>
      </div>
      <div hidden justify="end" lg:flex>
        <div
          max="w-xs"
          rounded="3xl"
          border="white"
          bg="white"
          p="5"
          shadow="lift"
          backdrop-blur
          dark="bg-slate-900"
        >
          <div flex items="center" gap="3">
            <span
              grid
              h="12"
              w="12"
              place="items-center"
              rounded="2xl"
              bg="brand-50"
              text="2xl brand-700"
            >
              ✦
            </span>
            <div>
              <p text="xs brand-600" font="bold">
                TRAVEL SMARTER
              </p>
              <h2 mt="1" text="lg" font="bold">
                예약 전, 핵심부터 확인
              </h2>
            </div>
          </div>
          <ul mt="4" space="y-3" text="sm slate-600" dark="text-slate-300">
            <li>✓ 위치와 이동 동선</li>
            <li>✓ 객실 인원 및 취소 조건</li>
            <li>✓ 시설 정보와 공식 출처</li>
            <li>✓ 제휴 링크 및 광고 고지</li>
          </ul>
          <a
            href="/guides/japan-hotel-booking-checklist/"
            mt="5"
            btn-primary
            w="full"
          >
            예약 체크리스트 보기 →
          </a>
        </div>
      </div>
    </div>
  </section>
  <section container-wide py="10" sm="py-14">
    <div flex items="end" justify="between" gap="4">
      <div>
        <p eyebrow>EXPLORE JAPAN</p>
        <h2 mt="2" section-title>
          어디로 떠나고 싶으세요?
        </h2>
        <p mt="3" muted-copy>
          여행 일정과 스타일에 맞는 지역부터 둘러보세요.
        </p>
      </div>
      <a
        href="/regions/"
        hidden
        text="sm brand-600"
        font="bold"
        hover="text-brand-700"
        sm:block
      >
        모든 지역 보기 →
      </a>
    </div>
    <div mt="6" grid="cols-2" gap="3" sm="grid-cols-3" lg="grid-cols-6">
      {regions.map((region) => (
        <a
          href={`/regions/${region.slug}/`}
          group
          relative
          isolate
          min="h-44"
          overflow="hidden"
          rounded="2xl"
          bg="slate-300"
          shadow="card"
        >
          <img
            src={region.image}
            alt={`${region.name} 여행 풍경`}
            loading="lazy"
            width="500"
            height="600"
            absolute
            inset="0"
            -z-20
            h="full"
            w="full"
            object="cover"
            transition
            duration="500"
            group-hover="scale-110"
          />
          <div
            absolute
            inset="0"
            -z-10
            bg="gradient-to-t"
            from-slate-950
            via-slate-900
            to-transparent
          ></div>
          <div absolute inset="x-0" bottom="0" p="4" text="white" text-center>
            <p text="[10px] white" font="bold" tracking="tight">
              {region.en.toUpperCase()}
            </p>
            <h3 mt="1" text="lg" font="bold">
              {region.name}
            </h3>
            <p mt="1" text="xs white" text-center>
              지역 가이드 →
            </p>
          </div>
        </a>
      ))}
    </div>
  </section>
  <section container-wide pb="8">
    <div flex="wrap" items="end" justify="between" gap="4">
      <div>
        <p eyebrow>HOTEL PICKS</p>
        <h2 mt="2" section-title>
          호텔 후보 살펴보기
        </h2>
        <p mt="3" muted-copy>
          여행 목적과 지역에 따라 비교할 후보를 소개합니다.
        </p>
      </div>
      <a href="/hotels/" text="sm brand-600" font="bold" hover="text-brand-700">
        호텔 전체 보기 →
      </a>
    </div>
    <div mt="6" grid gap="5" sm="grid-cols-2" lg="grid-cols-3">
      {hotels.slice(0, 3).map((hotel) => (
        <HotelCard hotel={hotel} />
      ))}
    </div>
    <AdSlot slot="home" label="홈페이지 광고" />
  </section>
  <section bg="white" py="12" dark="bg-slate-900" sm="py-16">
    <div container-wide>
      <div flex items="end" justify="between" gap="4">
        <div>
          <p eyebrow>TRAVEL KNOW-HOW</p>
          <h2 mt="2" section-title>
            예약 전에 읽어두면 좋은 가이드
          </h2>
          <p mt="3" muted-copy>
            가격만으로 판단하기 전에 꼭 확인할 정보를 모았습니다.
          </p>
        </div>
        <a href="/guides/" text="sm brand-600" font="bold">
          가이드 전체 보기 →
        </a>
      </div>
      <div mt="6" grid gap="4" lg="grid-cols-2">
        {guides.slice(0, 4).map((guide) => (
          <GuideCard guide={guide} />
        ))}
      </div>
    </div>
  </section>
  <section container-wide py="12" sm="py-16">
    <div
      overflow="hidden"
      rounded="3xl"
      bg="gradient-to-br"
      from-brand-700
      to-slate-900
      p="7"
      text="white"
      sm="p-10"
      lg:flex
      lg="items-center justify-between"
    >
      <div max="w-2xl">
        <p text="xs blue-200" font="bold" tracking="[.2em]">
          BOOKING CHECKLIST
        </p>
        <h2 mt="3" text="2xl sm:3xl" font="bold" leading="tight">
          예약 버튼을 누르기 전,
          <br hidden sm:block /> 조건을 한 번 더 확인하세요.
        </h2>
        <p mt="3" leading="7" text="sm sm:base blue-100">
          숙박 날짜, 인원, 세금 포함 여부, 취소 마감, 결제 조건은 예약 단계에서
          직접 확인해야 합니다.
        </p>
      </div>
      <a
        href="/guides/japan-hotel-booking-checklist/"
        mt="6"
        inline="flex"
        shrink-0
        items="center"
        justify="center"
        rounded="xl"
        bg="white"
        px="5"
        py="3"
        text="sm brand-700"
        font="bold"
        transition
        hover="bg-blue-50"
        lg="mt-0"
      >
        체크리스트 확인 →
      </a>
    </div>
  </section>
</SiteLayout>
