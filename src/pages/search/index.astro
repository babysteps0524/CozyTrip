---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { hotels, regions, guides } from '../../data/site';
---

<SiteLayout title="검색" description="일본 호텔, 지역, 여행 가이드를 검색하세요.">
  <section container-wide min="h-[60vh]" py="12" sm="py-16">
    <p eyebrow>SEARCH</p>
    <h1 mt="3" section-title>무엇을 찾고 계세요?</h1>
    <p mt="3" muted-copy>
      호텔명, 지역명, 여행 준비 키워드를 입력하세요.
    </p>
    <form
      id="search-form"
      mt="7"
      flex
      max="w-3xl"
      gap="2"
      rounded="2xl"
      border="line"
      bg="white"
      p="2"
      shadow="card"
      dark="border-slate-800 bg-slate-900"
    >
      <label flex="1" items="center" gap="3" px="3">
        <span text="xl brand-600">⌕</span>
        <input
          id="search-input"
          name="q"
          placeholder="예: 도쿄, 교토, 예약 취소"
          w="full"
          bg="transparent"
          py="3"
          text="sm"
          outline="none"
          aria-label="검색어"
        />
      </label>
      <button btn-primary type="submit">
        검색
      </button>
    </form>
    <div id="search-results" mt="8" space="y-3" aria-live="polite">
      <p muted-copy>
        검색어를 입력하면 관련 호텔과 가이드를 표시합니다.
      </p>
    </div>
  </section>
  <script lang="ts" define:vars={{
    hotelItems: hotels.map(({ name, city, area, summary, slug }) => ({
      name,
      city,
      area,
      summary,
      url: `/hotels/${slug}/`,
      kind: '호텔',
    })),
    regionItems: regions.map(({ name, subtitle, intro, slug }) => ({
      name,
      city: name,
      area: subtitle,
      summary: intro,
      url: `/regions/${slug}/`,
      kind: '지역',
    })),
    guideItems: guides.map(({ title, category, excerpt, slug }) => ({
      name: title,
      city: category,
      area: '여행 가이드',
      summary: excerpt,
      url: `/guides/${slug}/`,
      kind: '가이드',
    })),
  }}>
    const form = document.querySelector<HTMLFormElement>('#search-form');
    const input = document.querySelector<HTMLInputElement>('#search-input');
    const results = document.querySelector<HTMLElement>('#search-results');
    const all = [...hotelItems, ...regionItems, ...guideItems];

    function render(query: string) {
      if (!results) return;
      const q = query.trim().toLocaleLowerCase('ko');
      if (!q) {
        results.innerHTML =
          '<p text="sm slate-500">검색어를 입력하면 관련 결과가 표시됩니다.</p>';
        return;
      }
      const found = all.filter(
        (x) =>
          `${x.name} ${x.city} ${x.area} ${x.summary} ${x.kind}`
            .toLocaleLowerCase('ko')
            .includes(q),
      );
      results.innerHTML = found.length
        ? found
            .map(
              (x) =>
                `<a href="${x.url}" block rounded="2xl" border="line" bg="white" p="5" transition hover="border-brand-300 shadow-card" dark="border-slate-800 bg-slate-900"><span text="xs brand-600" font="bold">${x.kind} · ${x.city}</span><h2 mt="2" text="lg" font="bold">${x.name}</h2><p mt="2" text="sm slate-500" leading="6">${x.summary}</p><span mt="3" inline="block" text="sm brand-600" font="semibold">내용 보기 →</span></a>`,
            )
            .join('')
        : '<p rounded="2xl" border="line" bg="white" p="6" text="sm slate-500" dark="border-slate-800 bg-slate-900">일치하는 결과가 없습니다. 다른 키워드로 검색해 보세요.</p>';
    }

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const q = input?.value ?? '';
      render(q);
      history.replaceState(null, '', `?q=${encodeURIComponent(q)}`);
    });

    const initial = new URLSearchParams(location.search).get('q') ?? '';
    if (input) input.value = initial;
    if (initial) render(initial);
  </script>
</SiteLayout>
