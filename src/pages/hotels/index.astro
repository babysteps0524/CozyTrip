---
import SiteLayout from '../../layouts/SiteLayout.astro';
import HotelCard from '../../components/HotelCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { hotels } from '../../data/site';
import { getCollection, type CollectionEntry } from 'astro:content';

// 콘텐츠 컬렉션 호텔 (Agoda 파이프라인·studio가 생성한 MD 파일)
const contentEntries = await getCollection('hotels');
const existingSlugs = new Set(
  contentEntries.map((entry: CollectionEntry<'hotels'>) => entry.id),
);
const contentHotels = contentEntries.map(
  (entry: CollectionEntry<'hotels'>) => ({
    name: entry.data.name,
    city: entry.data.city,
    area: entry.data.area,
    summary: entry.data.summary,
    image: entry.data.image ?? undefined,
    type: entry.data.type,
    tags: entry.data.tags,
    status: entry.data.status,
    slug: entry.id,
  }),
);
const staticHotels = hotels.filter((hotel) => !existingSlugs.has(hotel.slug));
const allHotels = [...contentHotels, ...staticHotels];
---

<SiteLayout
  title="일본 호텔"
  description="도쿄, 오사카, 교토 등 일본 주요 지역의 호텔 후보와 예약 전 확인 정보를 살펴보세요."
>
  <section container-wide py="12" sm="py-16">
    <p eyebrow>HOTEL DIRECTORY</p>
    <h1 mt="3" section-title>
      일본 호텔 둘러보기
    </h1>
    <p mt="3" muted-copy max="w-2xl">
      호텔 이름과 지역, 여행 목적을 기준으로 후보를 살펴보세요. 아래 소개는 편집
      검토용 초안이며, 세부 정보는 공식 출처로 검증한 뒤 게시해야 합니다.
    </p>
    <div mt="7" grid gap="5" sm="grid-cols-2" lg="grid-cols-3">
      {allHotels.map((hotel) => (
        <HotelCard hotel={hotel as any} />
      ))}
    </div>
    <AdSlot />
  </section>
</SiteLayout>
