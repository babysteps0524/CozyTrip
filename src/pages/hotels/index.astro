---
import SiteLayout from '../../layouts/SiteLayout.astro';
import HotelCard from '../../components/HotelCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { hotels } from '../../data/site';
import { readdir, readFile } from 'node:fs/promises';
import { join } from 'node:path';

const CONTENT_DIR = join(process.cwd(), 'src/content/hotels');

async function loadContentHotelData(): Promise<
  Array<{
    name: string;
    city: string;
    area?: string;
    summary: string;
    image?: string;
    type?: string;
    tags?: string[];
    status?: string;
    slug: string;
  }>
> {
  try {
    const files = await readdir(CONTENT_DIR);
    const mdFiles = files.filter(
      (f) => f.endsWith('.md') || f.endsWith('.mdx'),
    );
    const results: Array<{
      name: string;
      city: string;
      area?: string;
      summary: string;
      image?: string;
      type?: string;
      tags?: string[];
      status?: string;
      slug: string;
    }> = [];
    for (const file of mdFiles) {
      const filePath = join(CONTENT_DIR, file);
      const content = await readFile(filePath, 'utf-8');
      const slug = file.replace(/\.(md|mdx)$/, '');
      const fmMatch = content.match(/^---\n([\s\S]*?)\n---\n([\s\S]*)$/);
      if (fmMatch) {
        const fmText = fmMatch[1];
        const data: Record<string, unknown> = {};
        for (const line of fmText.split('\n')) {
          const colonIdx = line.indexOf(':');
          if (colonIdx > 0) {
            const key = line.slice(0, colonIdx).trim();
            let val = line.slice(colonIdx + 1).trim();
            if (val.startsWith('"') && val.endsWith('"')) {
              val = val.slice(1, -1);
            }
            data[key] = val;
          }
        }
        results.push({
          name: String(data.name ?? ''),
          city: String(data.city ?? ''),
          area: data.area ? String(data.area) : undefined,
          summary: String(data.summary ?? ''),
          image: data.image ? String(data.image) : undefined,
          type: data.type ? String(data.type) : undefined,
          tags: data.tags
            ? String(data.tags)
                .split(',')
                .map((t) => t.trim())
            : undefined,
          status: data.status ? String(data.status) : undefined,
          slug,
        });
      }
    }
    return results;
  } catch {
    return [];
  }
}

const contentHotels = await loadContentHotelData();
const existingSlugs = new Set(contentHotels.map((h) => h.slug));
const staticHotels = hotels.filter((hotel) => !existingSlugs.has(hotel.slug));
const allHotels = [...contentHotels, ...staticHotels];
---

<SiteLayout
  title="일본 호텔"
  description="도쿄, 오사카, 교토 등 일본 주요 지역의 호텔 후보와 예약 전 확인 정보를 살펴보세요."
>
  <section container-wide py="12" sm="py-16">
    <p eyebrow>HOTEL DIRECTORY</p>
    <h1 mt="3" section-title>
      일본 호텔 둘러보기
    </h1>
    <p mt="3" muted-copy max="w-2xl">
      호텔 이름과 지역, 여행 목적을 기준으로 후보를 살펴보세요. 아래 소개는 편집
      검토용 초안이며, 세부 정보는 공식 출처로 검증한 뒤 게시해야 합니다.
    </p>
    <div mt="7" grid gap="5" sm="grid-cols-2" lg="grid-cols-3">
      {allHotels.map((hotel) => (
        <HotelCard hotel={hotel as any} />
      ))}
    </div>
    <AdSlot />
  </section>
</SiteLayout>
