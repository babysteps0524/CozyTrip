---
import SiteLayout from '../../layouts/SiteLayout.astro';
export const noindex = true;
---

<SiteLayout
  title="콘텐츠 초안 생성 도구"
  description="출처와 확인 상태를 입력해 호텔 소개 검토용 초안을 생성합니다."
  noindex={true}
>
  <section container-wide max="w-5xl" py="10" sm="py-14">
    <p eyebrow>EDITORIAL WORKSPACE</p>
    <h1 mt="3" section-title>
      호텔 콘텐츠 초안 생성
    </h1>
    <p mt="3" muted-copy max="w-3xl">
      확인한 자료를 정리해 Markdown 초안을 내려받는 브라우저 도구입니다. 입력
      내용은 이 정적 페이지에서 서버로 전송되지 않으며, 초안은 자동 게시되지
      않습니다. 호텔 정보는 직접 검증해야 합니다.
    </p>
    <div
      mt="6"
      rounded="2xl"
      border="brand-100 dark:brand-700"
      bg="brand-50 dark:brand-900/30"
      p="4"
      text="sm brand-700 dark:brand-100"
      leading="6"
    >
      <strong>주의:</strong> 실제 가격, 객실 가능 여부, 별점, 리뷰 수를 근거
      없이 입력하지 마세요. 아고다 제휴 링크는 승인된 계정에서 발급받고 검증한
      URL만 입력하세요.
    </div>
    <form
      id="draft-form"
      mt="8"
      grid
      gap="5"
      rounded="3xl"
      border="line dark:neutral-800"
      bg="white dark:neutral-900"
      p="5"
      shadow="card"
      sm="p-8"
    >
      <div grid gap="4" sm="grid-cols-2">
        <label block text="sm" font="semibold">
          호텔명 *
          <input
            required
            name="name"
            mt="2"
            w="full"
            rounded="xl"
            border="line dark:neutral-700"
            bg="white dark:neutral-950"
            px="4"
            py="3"
            font="normal"
            outline="none"
            focus="border-brand-500"
            placeholder="공식 표기와 동일한 이름"
          />
        </label>
        <label block text="sm" font="semibold">
          도시/지역 *
          <input
            required
            name="city"
            mt="2"
            w="full"
            rounded="xl"
            border="line dark:neutral-700"
            bg="white dark:neutral-950"
            px="4"
            py="3"
            font="normal"
            outline="none"
            focus="border-brand-500"
            placeholder="예: 도쿄 / 신주쿠"
          />
        </label>
      </div>
      <label block text="sm" font="semibold">
        소개 초안에 사용할 검증된 요약 *
        <textarea
          required
          name="summary"
          rows="4"
          minlength="40"
          mt="2"
          w="full"
          rounded="xl"
          border="line dark:neutral-700"
          bg="white dark:neutral-950"
          px="4"
          py="3"
          font="normal"
          leading="7"
          outline="none"
          focus="border-brand-500"
          placeholder="공식 출처로 확인한 사실만 작성하세요. 최소 40자."
        ></textarea>
      </label>
      <label block text="sm" font="semibold">
        호텔 공식 페이지 URL
        <input
          name="officialUrl"
          type="url"
          mt="2"
          w="full"
          rounded="xl"
          border="line dark:neutral-700"
          bg="white dark:neutral-950"
          px="4"
          py="3"
          font="normal"
          outline="none"
          focus="border-brand-500"
          placeholder="https://..."
        />
      </label>
      <label block text="sm" font="semibold">
        출처 목록 (한 줄에 하나씩: 출처 이름 | URL | 확인 날짜)
        <textarea
          name="sources"
          rows="4"
          mt="2"
          w="full"
          rounded="xl"
          border="line dark:neutral-700"
          bg="white dark:neutral-950"
          px="4"
          py="3"
          font="normal"
          leading="7"
          outline="none"
          focus="border-brand-500"
          placeholder="호텔 공식 웹사이트 | https://... | 2026-10-20"
        ></textarea>
      </label>
      <label block text="sm" font="semibold">
        확인한 사실 (한 줄에 하나씩: 항목 | 값 | 출처 URL | 검증 완료 여부
        true/false)
        <textarea
          name="facts"
          rows="5"
          mt="2"
          w="full"
          rounded="xl"
          border="line dark:neutral-700"
          bg="white dark:neutral-950"
          px="4"
          py="3"
          font="normal"
          leading="7"
          outline="none"
          focus="border-brand-500"
          placeholder="공식 주소 | 공식 페이지에 표시된 주소 | https://... | true"
        ></textarea>
      </label>
      <div grid gap="4" sm="grid-cols-2">
        <label block text="sm" font="semibold">
          이미지 권리 상태
          <select
            name="imageRights"
            mt="2"
            w="full"
            rounded="xl"
            border="line dark:neutral-700"
            bg="white dark:neutral-950"
            px="4"
            py="3"
            font="normal"
            outline="none"
            focus="border-brand-500"
          >
            <option value="unknown">미확인</option>
            <option value="needs_review">검토 필요</option>
            <option value="owned">직접 소유</option>
            <option value="licensed">라이선스 확인</option>
            <option value="approved_feed">승인된 피드/API</option>
          </select>
        </label>
        <label block text="sm" font="semibold">
          승인된 아고다 제휴 URL (선택)
          <input
            name="affiliateUrl"
            type="url"
            mt="2"
            w="full"
            rounded="xl"
            border="line dark:neutral-700"
            bg="white dark:neutral-950"
            px="4"
            py="3"
            font="normal"
            outline="none"
            focus="border-brand-500"
            placeholder="승인된 URL만 입력"
          />
        </label>
      </div>
      <div flex="wrap" gap="3">
        <button btn-primary type="submit">
          검토용 Markdown 생성 ↓
        </button>
        <button btn-secondary id="reset-form" type="reset">
          입력 지우기
        </button>
      </div>
      <p id="draft-status" text="sm muted" aria-live="polite">
        생성된 파일은 `needs_review` 상태이며 게시용 페이지에 자동 반영되지
        않습니다.
      </p>
    </form>
    <section
      id="preview-panel"
      hidden
      mt="8"
      rounded="3xl"
      border="line dark:neutral-800"
      bg="white dark:neutral-900"
      p="5"
    >
      <div flex="wrap" items="center" justify="between" gap="3">
        <h2 text="lg" font="bold">
          Markdown 미리보기
        </h2>
        <button id="download-again" btn-secondary type="button">
          다시 다운로드
        </button>
      </div>
      <pre
        id="draft-preview"
        mt="4"
        max="h-[560px]"
        overflow="auto"
        whitespace="pre-wrap"
        break="words"
        rounded="2xl"
        bg="neutral-50 dark:neutral-950"
        p="4"
        text="xs neutral-700 dark:neutral-300"
        leading="6"
      ></pre>
    </section>
  </section>
  <script>
    import { setupDraft } from './draft.ts';
    setupDraft(
      document.querySelector('#draft-form'),
      document.querySelector('#preview-panel'),
      document.querySelector('#draft-preview'),
      document.querySelector('#draft-status'),
    );
  </script>
</SiteLayout>
