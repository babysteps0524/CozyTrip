---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { readdir, readFile } from 'node:fs/promises';
import { join } from 'node:path';
export const noindex = true;

const CONTENT_DIR = join(process.cwd(), 'src/content/hotels');

interface HotelMeta {
  name: string;
  city: string;
  status: string;
  publish: boolean;
  source: string;
  factsVerified: boolean;
  imageRights: string;
  sourcesCount: number;
  fetchedAt?: string;
  slug: string;
}

async function loadHotels(): Promise<HotelMeta[]> {
  try {
    const files = await readdir(CONTENT_DIR);
    const mdFiles = files.filter(
      (f) => f.endsWith('.md') && !f.startsWith('.'),
    );
    const hotels: HotelMeta[] = [];
    for (const file of mdFiles) {
      const filePath = join(CONTENT_DIR, file);
      const content = await readFile(filePath, 'utf-8');
      const slug = file.replace(/\.md$/, '');
      const fmMatch = content.match(/^---\n([\s\S]*?)\n---\n/);
      if (fmMatch) {
        const fmText = fmMatch[1];
        const data: Record<string, string> = {};
        for (const line of fmText.split('\n')) {
          const colonIdx = line.indexOf(':');
          if (colonIdx > 0) {
            const key = line.slice(0, colonIdx).trim();
            let val = line.slice(colonIdx + 1).trim();
            if (val.startsWith('"') && val.endsWith('"')) {
              val = val.slice(1, -1);
            }
            data[key] = val;
          }
        }
        // sources 개수 계산 (배열 항목 수)
        const sourcesRaw = data.sources ?? '';
        const sourcesCount = sourcesRaw
          .split('\n')
          .filter((line) => line.trim().startsWith('- ['))
          .length;

        hotels.push({
          name: data.name ?? slug,
          city: data.city ?? '',
          status: data.status ?? 'unknown',
          publish: data.publish === 'true',
          source: data.source ?? 'unknown',
          factsVerified: data.factsVerified === 'true',
          imageRights: data.imageRights ?? 'unknown',
          sourcesCount,
          fetchedAt: data.fetchedAt,
          slug,
        });
      }
    }
    return hotels.sort((a, b) => a.name.localeCompare(b.name));
  } catch {
    return [];
  }
}

const hotels = await loadHotels();
const stats = {
  total: hotels.length,
  published: hotels.filter((h) => h.publish).length,
  needsReview: hotels.filter((h) => h.status === 'review').length,
  draft: hotels.filter((h) => h.status === 'draft').length,
  verified: hotels.filter((h) => h.factsVerified).length,
  imageRightsReady: hotels.filter(
    (h) => h.imageRights !== 'unknown' && h.imageRights !== 'needs_review',
  ).length,
};

// 호텔 상태별 배지 스타일 (UnoCSS Attributify 토큰)
// 클래스 문자열 대신 Attributify 속성으로 조건부 바인딩합니다.
const statusBadgeStyles: Record<
  string,
  { bg: string; text: string; darkBg: string; darkText: string }
> = {
  published: {
    bg: 'brand-100',
    text: 'brand-700',
    darkBg: 'brand-900/30',
    darkText: 'brand-400',
  },
  review: {
    bg: 'accent-100',
    text: 'accent-700',
    darkBg: 'accent-900/30',
    darkText: 'accent-400',
  },
  archived: {
    bg: 'neutral-100',
    text: 'neutral-500',
    darkBg: 'neutral-800',
    darkText: 'neutral-500',
  },
};
const defaultBadgeStyle = {
  bg: 'neutral-100',
  text: 'neutral-700',
  darkBg: 'neutral-800',
  darkText: 'neutral-300',
};

const getBadgeStyle = (status: string) =>
  statusBadgeStyles[status] ?? defaultBadgeStyle;
---

<SiteLayout
  title="호텔 콘텐츠 관리"
  description="아고다 API 연동 호텔 소개 콘텐츠를 관리합니다."
>
  <section container-wide py="12" sm="py-16">
    <p eyebrow>ADMIN</p>
    <h1 mt="3" section-title>
      호텔 콘텐츠 관리
    </h1>
    <p mt="3" muted-copy max="w-2xl">
      아고다 API를 통해 수집된 호텔 소개 콘텐츠의 현황을 확인하고 관리합니다.
    </p>

    <!-- 통계 카드 -->
    <div mt="8" grid gap="4" sm="grid-cols-3" lg="grid-cols-5" max="w-4xl">
      <div
        rounded="2xl"
        border="line"
        bg="white"
        p="5"
        dark="border-neutral-800 bg-neutral-900"
      >
        <p text="xs muted" font="bold">
          전체 호텔
        </p>
        <h2 mt="2" text="2xl" font="bold">
          {stats.total}
        </h2>
      </div>
      <div
        rounded="2xl"
        border="line"
        bg="white"
        p="5"
        dark="border-neutral-800 bg-neutral-900"
      >
        <p text="xs muted" font="bold">
          게시 완료
        </p>
        <h2 mt="2" text="2xl" font="bold" text="brand-500">
          {stats.published}
        </h2>
      </div>
      <div
        rounded="2xl"
        border="line"
        bg="white"
        p="5"
        dark="border-neutral-800 bg-neutral-900"
      >
        <p text="xs muted" font="bold">
          검토 필요
        </p>
        <h2 mt="2" text="2xl" font="bold" text="accent-500">
          {stats.needsReview}
        </h2>
      </div>
      <div
        rounded="2xl"
        border="line"
        bg="white"
        p="5"
        dark="border-neutral-800 bg-neutral-900"
      >
        <p text="xs muted" font="bold">
          검증 완료
        </p>
        <h2 mt="2" text="2xl" font="bold" text="brand-500">
          {stats.verified}
        </h2>
      </div>
      <div
        rounded="2xl"
        border="line"
        bg="white"
        p="5"
        dark="border-neutral-800 bg-neutral-900"
      >
        <p text="xs muted" font="bold">
          이미지 권리 확인
        </p>
        <h2 mt="2" text="2xl" font="bold" text="brand-500">
          {stats.imageRightsReady}
        </h2>
      </div>
    </div>

    <!-- 동기화 버튼 -->
    <div mt="8" flex="wrap" gap="3" max="w-4xl">
      <button
        btn-primary
        onclick="location.href='/api/sync-hotels'"
        disabled
        title="서버리스 함수 구현 필요"
      >
        아고다 API 동기화 실행
      </button>
      <button btn-secondary onclick="location.reload()">
        새로고침
      </button>
      <p mt="2" text="xs muted">
        동기화 기능은 서버리스 함수(/api/sync-hotels.ts) 구현 후 활성화됩니다.
      </p>
    </div>

    <!-- 호텔 목록 -->
    {hotels.length > 0 ? (
      <div mt="8" max="w-4xl">
        <div
          rounded="2xl"
          border="line"
          bg="white"
          dark="border-neutral-800 bg-neutral-900"
          overflow="auto"
        >
          <table w="full" text="sm">
            <thead>
              <tr border-b="line" dark="border-neutral-700">
                <th p="3" text="left" font="bold" text="neutral-600">
                  호텔명
                </th>
                <th p="3" text="left" font="bold" text="neutral-600">
                  도시
                </th>
                <th p="3" text="left" font="bold" text="neutral-600">
                  상태
                </th>
                <th p="3" text="left" font="bold" text="neutral-600">
                  검증
                </th>
                <th p="3" text="left" font="bold" text="neutral-600">
                  게시
                </th>
                <th p="3" text="left" font="bold" text="neutral-600">
                  출처
                </th>
                <th p="3" text="left" font="bold" text="neutral-600">
                  수집일
                </th>
                <th p="3" text="left" font="bold" text="neutral-600">
                  링크
                </th>
                <th p="3" text="left" font="bold" text="neutral-600">
                  작업
                </th>
              </tr>
            </thead>
            <tbody>
              {hotels.map((h) => {
                const nextStatusMap: Record<string, string> = {
                  draft: 'review',
                  review: 'published',
                  published: 'archived',
                  archived: 'draft',
                };
                const nextStatus = nextStatusMap[h.status] ?? 'review';

                const isPublishReady =
                  h.factsVerified &&
                  h.sourcesCount > 0 &&
                  h.imageRights !== 'unknown' &&
                  h.imageRights !== 'needs_review';

                const statusLabelMap: Record<string, string> = {
                  published: '게시됨',
                  review: '검토 필요',
                  draft: '초안',
                  archived: '보관됨',
                };

                return (
                  <tr
                    border-b="line"
                    dark="border-neutral-800/50"
                    hover="bg-neutral-50"
                    dark:hover="bg-neutral-800/50"
                  >
                    <td p="3" font="medium" text="neutral-900">
                      {h.name}
                    </td>
                    <td p="3" text="sm" text="neutral-600">
                      {h.city}
                    </td>
                    <td p="3">
                      <span
                        inline="flex"
                        items="center"
                        rounded="full"
                        px="2.5"
                        py="0.5"
                        text="xs"
                        font="medium"
                        bg={getBadgeStyle(h.status).bg}
                        text={getBadgeStyle(h.status).text}
                        dark:bg={getBadgeStyle(h.status).darkBg}
                        dark:text={getBadgeStyle(h.status).darkText}
                      >
                        {statusLabelMap[h.status] ?? h.status}
                      </span>
                    </td>
                    <td p="3" text="xs">
                      <div flex="col" gap="0.5">
                        <span
                          flex
                          items="center"
                          gap="1"
                          text="[10px]"
                          font="medium"
                          text={
                            h.factsVerified
                              ? 'brand-500 dark:brand-400'
                              : 'neutral-500 dark:neutral-500'
                          }
                        >
                          {h.factsVerified ? '✓' : '✗'} 사실 검증
                        </span>
                        <span
                          flex
                          items="center"
                          gap="1"
                          text="[10px]"
                          font="medium"
                          text={
                            h.imageRights !== 'unknown' &&
                            h.imageRights !== 'needs_review'
                              ? 'brand-500 dark:brand-400'
                              : 'neutral-500 dark:neutral-500'
                          }
                        >
                          {h.imageRights !== 'unknown' &&
                          h.imageRights !== 'needs_review'
                            ? '✓'
                            : '✗'} 이미지 권리
                        </span>
                        <span
                          block
                          text="[10px]"
                          text="neutral-400 dark:neutral-500"
                          font="medium"
                        >
                          출처 {h.sourcesCount}개
                        </span>
                      </div>
                    </td>
                    <td p="3">
                      {h.publish ? (
                        <span
                          inline="flex"
                          items="center"
                          rounded="full"
                          px="2.5"
                          py="0.5"
                          text="xs"
                          font="medium"
                          bg="brand-100"
                          text="brand-700"
                          dark:bg="brand-900/30"
                          dark:text="brand-400"
                        >
                          ✓ 예
                        </span>
                      ) : (
                        <span
                          inline="flex"
                          items="center"
                          rounded="full"
                          px="2.5"
                          py="0.5"
                          text="xs"
                          font="medium"
                          bg="neutral-100"
                          text="neutral-700"
                          dark:bg="neutral-800"
                          dark:text="neutral-300"
                        >
                          아니오
                        </span>
                      )}
                    </td>
                    <td p="3" text="sm" text="neutral-500">
                      {h.source}
                    </td>
                    <td p="3" text="sm" text="neutral-500">
                      {h.fetchedAt ?? '-'}
                    </td>
                    <td p="3">
                      <a
                        href={`/hotels/${h.slug}/`}
                        text="sm"
                        text="brand-600"
                        font="medium"
                      >
                        보기 →
                      </a>
                    </td>
                    <td p="3">
                      <div flex="col" gap="1">
                        <button
                          data-slug={h.slug}
                          data-current={h.status}
                          data-next={nextStatus}
                          onclick="handleStatusChange(this)"
                          btn-primary
                          text="[10px]"
                          py="1"
                          px="2"
                          disabled={
                            nextStatus === 'published' && !isPublishReady
                          }
                          title={
                            nextStatus === 'published' && !isPublishReady
                              ? '검증 조건 미충족: 사실 검증, 출처, 이미지 권리를 확인하세요.'
                              : `상태를 ${nextStatus}로 변경`
                          }
                        >
                          {nextStatus === 'published' && !isPublishReady
                            ? '게시 불가'
                            : `→ ${nextStatus}`}
                        </button>
                        {nextStatus === 'published' && !isPublishReady && (
                          <p
                            mt="0.5"
                            text="[10px]"
                            text="neutral-500 dark:neutral-500"
                            max="w-24"
                          >
                            검증 필요
                          </p>
                        )}
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        {hotels.length === 0 && (
          <p mt="4" text="sm" text="neutral-500" max="w-4xl">
            등록된 호텔 콘텐츠가 없습니다. 동기화를 먼저 실행하세요.
          </p>
        )}
      </div>
    ) : (
      <p mt="8" text="sm" text="neutral-500" max="w-4xl">
        등록된 호텔 콘텐츠가 없습니다.
      </p>
    )}
    <!-- 상태 전이 안내 -->
    <div mt="8" max="w-4xl">
      <div
        rounded="2xl"
        border="line dark:neutral-800"
        bg="neutral-50 dark:neutral-950"
        p="5"
      >
        <h2 text="lg" font="bold" mb="3">
          상태 전이 명령어
        </h2>
        <p mt="0" text="sm muted dark:neutral-400">
          테이블의 상태 전이 버튼을 클릭하면 CLI 명령어가 클립보드에
          복사됩니다. 터미널에서 실행하여 실제 파일의 상태를 변경하세요.
        </p>
        <div mt="3">
          <p text="xs font-bold neutral-600 dark:neutral-400" mb="1">
            예시:
          </p>
          <div
            rounded="xl"
            bg="white dark:neutral-900"
            p="3"
            text="sm"
            font="mono"
            text="neutral-700 dark:neutral-300"
            border="line dark:neutral-700"
          >
            bun run content:status --slug hotel-gracery-shinjuku --status published
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    function handleStatusChange(button: HTMLButtonElement) {
      const slug = button.getAttribute('data-slug');
      const current = button.getAttribute('data-current');
      const next = button.getAttribute('data-next');

      if (!slug || !current || !next) {
        alert('호텔 정보를 찾을 수 없습니다.');
        return;
      }

      if (
        !confirm(
          `상태를 "${current}"에서 "${next}"로 변경하시겠습니까?`,
        )
      ) {
        return;
      }

      const command = `bun run content:status --slug ${slug} --status ${next}`;

      navigator.clipboard
        .writeText(command)
        .then(() => {
          alert(
            `CLI 명령어가 클립보드에 복사되었습니다.\n\n${command}\n\n터미널에서 실행하여 상태를 변경하세요.`,
          );
        })
        .catch(() => {
          alert(
            `다음 명령을 터미널에서 실행하세요:\n\n${command}`,
          );
        });
    }
  </script>
</SiteLayout>
