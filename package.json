{
  "name": "cozytrip",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@unocss/preset-wind4": "^66.10.4"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "bun scripts/validate-hotel-data.ts && bun scripts/split-client-hotel-data.ts && bun scripts/split-client-post-data.ts && vite build && bun scripts/ssg.ts && bun scripts/generate-sitemap.ts && bun scripts/generate-rss.ts",
    "preview": "vite preview",
    "typecheck": "bun scripts/split-client-post-data.ts && tsc --noEmit",
    "validate:hotels": "bun scripts/validate-hotel-data.ts",
    "validate:hotel-posts": "bun scripts/validate-hotel-posts.ts",
    "validate:seo": "bun scripts/validate-seo.ts",
    "agoda:test": "bun scripts/agoda/test-api.ts",
    "agoda:cities": "bun scripts/agoda/fetch-cities.ts",
    "agoda:generate": "bun scripts/agoda/generate-hotels.ts",
    "ai:hotel-posts": "bun scripts/generate-hotel-posts.ts",
    "agoda:status": "bun scripts/agoda/status.ts",
    "agoda:validate": "bun scripts/validate-hotel-data.ts",
    "myrealtrip:status": "bun scripts/myrealtrip/status.ts",
    "myrealtrip:test": "bun scripts/myrealtrip/test-api.ts",
    "myrealtrip:generate": "bun scripts/myrealtrip/generate-hotels.ts",
    "validate:hotel-run": "bun scripts/validate-hotel-run.ts",
    "validate:hotel-inventory": "bun scripts/validate-hotel-inventory.ts",
    "generate:hotel-inventory": "bun scripts/generate-hotel-inventory.ts",
    "myrealtrip:inspect": "bun scripts/myrealtrip/inspect-accommodation-results.ts",
    "myrealtrip:inspect-pagination": "bun scripts/myrealtrip/inspect-accommodation-pagination.ts",
    "validate:myrealtrip-images": "bun scripts/validate-myrealtrip-images.ts",
    "validate:hotel-daily-plan": "bun scripts/validate-hotel-daily-plan.ts",
    "validate:hotel-selection": "bun scripts/validate-hotel-selection.ts",
    "ai:repair-hotel-posts": "bun scripts/generate-hotel-posts.ts --repair-invalid=true",
    "myrealtrip:inspect-images": "bun scripts/myrealtrip/inspect-accommodation-images.ts"
  },
  "dependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@unocss/preset-attributify": "^66.10.4",
    "@unocss/reset": "^66.10.4",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "unocss": "^66.10.4",
    "vite": "^8.3.0"
  }
}
