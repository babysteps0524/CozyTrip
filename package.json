{
  "name": "cozytrip-japan-hotel-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
    "test": "bun test",
    "verify": "astro check && tsc --noEmit && bun test && astro build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lintFix": "eslint . --fix",
    "content:validate": "bun run scripts/validate-content.ts",
    "content:draft": "bun run scripts/create-draft.ts",
    "sync:agoda": "bun run scripts/sync-agoda-hotels.ts",
    "sync:agoda:dry-run": "bun run scripts/sync-agoda-hotels.ts --dry-run"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "astro": "^7.4.2",
    "zod": "^4.6.7",
    "@astrojs/sitemap": "^3.7.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.4",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@unocss/astro": "^66.12.0",
    "@unocss/preset-attributify": "^66.12.0",
    "@unocss/preset-rem-to-px": "^66.12.0",
    "@unocss/preset-typography": "^66.12.0",
    "@unocss/preset-web-fonts": "^66.12.0",
    "@unocss/preset-wind4": "^66.12.0",
    "@unocss/transformer-attributify-jsx": "^66.12.0",
    "@unocss/transformer-compile-class": "^66.12.0",
    "@unocss/transformer-directives": "^66.12.0",
    "@unocss/transformer-variant-group": "^66.12.0",
    "astro-eslint-parser": "^3.2.0",
    "bun-types": "^1.4.4",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-embed": "^0.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "6",
    "typescript-eslint": "^8.72.1",
    "unocss": "^66.12.0"
  }
}
