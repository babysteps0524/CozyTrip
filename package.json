{
  "name": "cozytrip-japan-hotel-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
    "test": "bun test",
    "verify": "astro check && tsc --noEmit && bun test && astro build",
    "format": "prettier --write .",
    "lint": "eslint .",
    "content:validate": "bun run scripts/validate-content.ts",
    "content:draft": "bun run scripts/create-draft.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.11",
    "astro": "^7.4.1",
    "typescript": "6",
    "zod": "^4.6.7",
    "@astrojs/sitemap": "^3.7.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.3",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@unocss/astro": "^66.11.0",
    "astro-eslint-parser": "^3.2.0",
    "bun-types": "^1.4.3",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-embed": "^0.8.1",
    "typescript-eslint": "^8.72.0",
    "unocss": "^66.11.0"
  }
}
