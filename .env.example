# CozyTrip local environment
# Agoda API 승인/자격정보를 받은 뒤 실제 값을 입력하세요.
# 현재는 비워 두어도 됩니다.

AGODA_BASE_URL=
AGODA_TOKEN=
AGODA_SITE_ID=

# 도시별 생성할 최대 호텔 수
AGODA_MAX_HOTELS=5

# MyRealTrip Marketing Partner API
# API Key는 절대 프론트엔드 코드나 GitHub에 직접 입력하지 마세요.
MYREALTRIP_API_KEY=
# 마이리얼트립 개발자센터에서 안내받은 Partner API Base URL
MYREALTRIP_BASE_URL=


# MyRealTrip API 이미지 URL을 CozyTrip에서 직접 표시할지 여부
# 기본값은 false입니다. 이미지 사용 조건을 확인한 뒤 true로 변경하세요.
MYREALTRIP_IMAGE_USAGE_ALLOWED=false
